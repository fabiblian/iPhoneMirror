<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.PasscodeEntryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
    xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:IPhoneMirror.App.Controls"
    Width="440" SizeToContent="Height" Title="{DynamicResource PasscodeEntryTitle}"
    WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
    WindowStyle="None" AllowsTransparency="True" Background="Transparent"
    Foreground="{DynamicResource TextBrush}">
    <chrome:RoundedWindow.Resources>
        <!-- Same look as RoundedTextBox; PasswordBox cannot use a TextBox style. -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ComboBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize21}"/>
            <Setter Property="Padding" Value="{StaticResource InputPadding}"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="InputRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource ComboHoverBrush}"/>
                                <Setter TargetName="InputRoot" Property="BorderBrush" Value="{DynamicResource ComboBorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputRoot" Property="Background" Value="{DynamicResource ComboOpenBrush}"/>
                                <Setter TargetName="InputRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </chrome:RoundedWindow.Resources>
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource PasscodeEntryTitle}" Style="{StaticResource SubWindowTitle}"/>
                <TextBlock x:Name="DeviceLabel" Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="{DynamicResource BodyFontSize}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCancelClick">
                <ui:SymbolIcon Symbol="Dismiss20" Style="{StaticResource ButtonSymbolIcon}"/>
            </Button>
        </Grid>
        <StackPanel Grid.Row="1" Margin="0,16">
            <controls:InfoRow>
                <TextBlock x:Name="PromptLabel" Text="{DynamicResource PasscodeEntryPrompt}" Style="{StaticResource BodyText}"/>
                <controls:InfoTip Text="{DynamicResource PasscodeEntryPrivacy}"/>
            </controls:InfoRow>
            <PasswordBox x:Name="PasscodeBox" Style="{StaticResource RoundedPasswordBox}" Margin="0,12,0,0"
                         MaxLength="16" InputMethod.IsInputMethodEnabled="False"
                         AutomationProperties.AutomationId="PasscodeBox"
                         AutomationProperties.LabeledBy="{Binding ElementName=PromptLabel}"
                         PreviewTextInput="OnPasscodePreviewTextInput" PasswordChanged="OnPasscodeChanged"/>
        </StackPanel>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="{StaticResource DialogActionsInset}">
            <Button Content="{DynamicResource Cancel}" Click="OnCancelClick" IsCancel="True"
                    Margin="{StaticResource DialogActionMargin}" MinWidth="88"/>
            <Button x:Name="ConfirmButton" Content="{DynamicResource PasscodeEntryConfirm}" Click="OnConfirmClick" IsDefault="True"
                    IsEnabled="False" AutomationProperties.AutomationId="PasscodeConfirmButton"
                    Style="{StaticResource PrimaryButton}" Margin="{StaticResource DialogActionMargin}" MinWidth="104"/>
        </WrapPanel>
    </Grid>
</chrome:RoundedWindow>
