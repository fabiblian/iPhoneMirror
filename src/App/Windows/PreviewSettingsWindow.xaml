<chrome:RoundedWindow x:Class="IPhoneMirror.App.Windows.PreviewSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:IPhoneMirror.UI.Controls"
        xmlns:animations="clr-namespace:IPhoneMirror.UI.Animations"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{DynamicResource PreviewSettingsTitle}"
        Width="600" Height="680" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown"
        Foreground="{DynamicResource TextBrush}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Grid Style="{StaticResource SubWindowPageRoot}" animations:PageTransition.IsEnabled="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*" MinHeight="{StaticResource DialogContentMinHeight}"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Style="{StaticResource SubWindowHeader}" animations:WindowDragBehavior.IsEnabled="True">
            <StackPanel Margin="0,0,48,0">
                <TextBlock Text="{DynamicResource PreviewSettingsTitle}" Style="{StaticResource SubWindowTitle}"/>
                <TextBlock Text="{DynamicResource PreviewSettingsDescription}" Style="{StaticResource SubWindowSubtitle}"/>
            </StackPanel>
            <Button Style="{StaticResource SubWindowCloseButton}" Click="OnCloseClick">
                <ui:SymbolIcon Style="{StaticResource ButtonSymbolIcon}" Symbol="Dismiss20" FontSize="18"/>
            </Button>
        </Grid>
        <!-- Right padding lives inside the scroller so the scrollbar sits at the edge, clear of text. -->
        <Border Grid.Row="2" Style="{StaticResource SettingsSection}" Padding="20,16,4,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,16,0">
                    <CheckBox x:Name="ShowPreviewCheckBox" Content="{DynamicResource ShowPreview}"
                              Checked="OnShowPreviewChanged" Unchecked="OnShowPreviewChanged"
                              AutomationProperties.AutomationId="ShowPreviewCheckBox"/>
                    <CheckBox x:Name="ShowAppCheckBox" Content="{DynamicResource ShowApp}" Margin="0,10,0,0"
                              Checked="OnShowAppChanged" Unchecked="OnShowAppChanged"
                              AutomationProperties.AutomationId="ShowAppCheckBox"/>
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18"/>
                    <!-- Look: borderless or an iPhone case -->
                    <TextBlock Text="{DynamicResource PreviewLookTitle}" FontWeight="SemiBold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BorderlessTile" Click="OnBorderlessTileClick" Padding="12" BorderThickness="1"
                                HorizontalContentAlignment="Stretch" Background="{DynamicResource ControlFillBrush}"
                                AutomationProperties.AutomationId="PreviewBorderlessTile"
                                AutomationProperties.Name="{DynamicResource PreviewLookBorderless}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="30" Height="60" CornerRadius="8" Margin="0,0,12,0"
                                        Background="#F5F5F7"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource PreviewLookBorderless}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource PreviewLookBorderlessHelp}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button x:Name="CaseTile" Grid.Column="2" Click="OnCaseTileClick" Padding="12" BorderThickness="1"
                                HorizontalContentAlignment="Stretch" Background="{DynamicResource ControlFillBrush}"
                                AutomationProperties.AutomationId="PreviewCaseTile"
                                AutomationProperties.Name="{DynamicResource PreviewLookCase}">
                            <DockPanel>
                                <Border x:Name="CaseTileSample" DockPanel.Dock="Left" Width="34" Height="64" CornerRadius="10"
                                        Padding="3" Margin="0,0,12,0" Background="#1C1C1F">
                                    <Border CornerRadius="7" Background="#F5F5F7"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource PreviewLookCase}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource PreviewLookCaseHelp}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                                </StackPanel>
                            </DockPanel>
                        </Button>
                    </Grid>
                    <WrapPanel x:Name="CaseColors" Margin="0,10,0,0"/>

                    <!-- Controls drawn over the preview -->
                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18"/>
                    <TextBlock Text="{DynamicResource PreviewControlsTitle}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="HoverOnlyCheckBox" Margin="0,10,0,0" Content="{DynamicResource PreviewControlsOnHover}"
                              Checked="OnEverydayCheckChanged" Unchecked="OnEverydayCheckChanged"
                              AutomationProperties.AutomationId="PreviewControlsOnHoverCheckBox"/>
                    <CheckBox x:Name="SnapCheckBox" Margin="0,8,0,0" Content="{DynamicResource PreviewSnapToEdges}"
                              Checked="OnEverydayCheckChanged" Unchecked="OnEverydayCheckChanged"
                              AutomationProperties.AutomationId="PreviewSnapToEdgesCheckBox"/>
                    <TextBlock Text="{DynamicResource PreviewControlsHelp}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>

                    <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18"/>
                    <!-- Frame -->
                    <TextBlock Text="{DynamicResource PreviewFrameTitle}" FontWeight="SemiBold"/>
                    <CheckBox x:Name="FrameEnabledCheckBox" Margin="0,10,0,0"
                              Content="{DynamicResource PreviewFrameShow}"
                              Checked="OnFrameEnabledChanged" Unchecked="OnFrameEnabledChanged"
                              AutomationProperties.AutomationId="PreviewFrameEnabledCheckBox"/>
                    <TextBlock Text="{DynamicResource PreviewFrameHelp}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                    <StackPanel x:Name="FrameOptions" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource PreviewFrameThickness}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding ElementName=ThicknessSlider, Path=Value, StringFormat={}{0:F0} px}"/>
                        </Grid>
                        <Slider x:Name="ThicknessSlider" Minimum="4" Maximum="48" Value="12"
                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="4"
                                Margin="0,6,0,12" ValueChanged="OnThicknessChanged"
                                AutomationProperties.AutomationId="PreviewFrameThicknessSlider"
                                AutomationProperties.Name="{DynamicResource PreviewFrameThickness}"/>
                        <TextBlock Text="{DynamicResource PreviewFrameColor}"/>
                        <CheckBox x:Name="AccentColorCheckBox" Margin="0,8,0,0"
                                  Content="{DynamicResource PreviewFrameAccentColor}"
                                  Checked="OnAccentColorChanged" Unchecked="OnAccentColorChanged"
                                  AutomationProperties.AutomationId="PreviewFrameAccentColorCheckBox"/>
                        <TextBlock Text="{DynamicResource PreviewFrameAccentColorHelp}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                        <StackPanel x:Name="OtherColorOptions">
                        <CheckBox x:Name="AutoColorCheckBox" Margin="0,8,0,0"
                                  Content="{DynamicResource PreviewFrameAutoColor}"
                                  Checked="OnAutoColorChanged" Unchecked="OnAutoColorChanged"
                                  AutomationProperties.AutomationId="PreviewFrameAutoColorCheckBox"/>
                        <TextBlock Text="{DynamicResource PreviewFrameAutoColorHelp}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                        <StackPanel x:Name="FixedColorOptions">
                            <WrapPanel x:Name="Swatches" Margin="0,8,0,6"/>
                            <TextBox x:Name="ColorTextBox" MaxLength="7" Margin="0,0,0,12" Width="120"
                                     HorizontalAlignment="Left"
                                     ToolTip="{DynamicResource PreviewFrameColorHex}"
                                     LostKeyboardFocus="OnColorTextCommitted" KeyDown="OnColorTextKeyDown"
                                     AutomationProperties.AutomationId="PreviewFrameColorTextBox"
                                     AutomationProperties.Name="{DynamicResource PreviewFrameColorHex}"/>
                        </StackPanel>
                        </StackPanel>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource PreviewFrameOpacity}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F0}%}"/>
                        </Grid>
                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100"
                                TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                Margin="0,6,0,0" ValueChanged="OnOpacityChanged"
                                AutomationProperties.AutomationId="PreviewFrameOpacitySlider"
                                AutomationProperties.Name="{DynamicResource PreviewFrameOpacity}"/>

                        <!-- Home button -->
                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18"/>
                        <TextBlock Text="{DynamicResource PreviewHomeTitle}" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource PreviewHomeHelp}" TextWrapping="Wrap" Margin="0,6,0,10"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource PreviewHomeStyle}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="HomeStyleComboBox" SelectionChanged="OnHomeStyleChanged"
                                          AutomationProperties.AutomationId="PreviewHomeStyleComboBox"
                                          AutomationProperties.Name="{DynamicResource PreviewHomeStyle}">
                                    <ComboBoxItem Tag="Bar" Content="{DynamicResource PreviewHomeStyleBar}"/>
                                    <ComboBoxItem Tag="Pill" Content="{DynamicResource PreviewHomeStylePill}"/>
                                    <ComboBoxItem Tag="Off" Content="{DynamicResource PreviewHomeStyleOff}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource PreviewHomePosition}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="HomePositionComboBox" SelectionChanged="OnHomePositionChanged"
                                          AutomationProperties.AutomationId="PreviewHomePositionComboBox"
                                          AutomationProperties.Name="{DynamicResource PreviewHomePosition}">
                                    <ComboBoxItem Tag="Left" Content="{DynamicResource PreviewHomePositionLeft}"/>
                                    <ComboBoxItem Tag="Center" Content="{DynamicResource PreviewHomePositionCenter}"/>
                                    <ComboBoxItem Tag="Right" Content="{DynamicResource PreviewHomePositionRight}"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Control -->
                        <Border Height="1" Background="{DynamicResource BorderSoftBrush}" Margin="0,18"/>
                        <TextBlock Text="{DynamicResource PreviewControlTitle}" FontWeight="SemiBold"/>
                        <CheckBox x:Name="AutoStartControlCheckBox" Margin="0,10,0,0"
                                  Content="{DynamicResource PreviewAutoStartControl}"
                                  Checked="OnAutoStartControlChanged" Unchecked="OnAutoStartControlChanged"
                                  AutomationProperties.AutomationId="PreviewAutoStartControlCheckBox"/>
                        <TextBlock Text="{DynamicResource PreviewAutoStartControlHelp}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{DynamicResource CaptionFontSize}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Button Content="{DynamicResource PreviewFrameReset}" HorizontalAlignment="Left" Click="OnResetClick"
                    AutomationProperties.AutomationId="PreviewSettingsResetButton"/>
            <Button Content="{DynamicResource Close}" HorizontalAlignment="Right" MinWidth="88"
                    Style="{StaticResource PrimaryButton}" Click="OnCloseClick"/>
        </Grid>
    </Grid>
</chrome:RoundedWindow>
