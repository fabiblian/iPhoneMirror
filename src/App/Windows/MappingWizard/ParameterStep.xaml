<UserControl x:Class="IPhoneMirror.App.Windows.MappingWizard.ParameterStep"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:IPhoneMirror.App.Controls">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibleWhen"/></UserControl.Resources>
 <StackPanel MaxWidth="400" VerticalAlignment="Center">
  <StackPanel x:Name="DirectionPanel" Visibility="{Binding IsSwipe, Converter={StaticResource VisibleWhen}}">
   <controls:InfoRow Margin="0,12,0,4">
    <TextBlock Text="{DynamicResource MappingSwipeDirection}" Style="{StaticResource DetailLabel}" Margin="0"/>
    <controls:InfoTip Text="{DynamicResource WizardSwipeTiming}"/>
   </controls:InfoRow>
   <ComboBox x:Name="DirectionBox" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource MappingSwipeDirection}"/>
  </StackPanel>
  <StackPanel x:Name="DurationPanel" Visibility="{Binding ShowDuration, Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{DynamicResource MappingDuration}" Style="{StaticResource DetailLabel}"/>
   <TextBox x:Name="DurationBox" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"
    AutomationProperties.Name="{DynamicResource MappingDuration}"/>
  </StackPanel>
  <StackPanel x:Name="IntervalPanel" Visibility="{Binding ShowInterval, Converter={StaticResource VisibleWhen}}">
   <TextBlock Text="{DynamicResource MappingInterval}" Style="{StaticResource DetailLabel}"/>
   <TextBox x:Name="IntervalBox" Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource RoundedTextBox}"
    AutomationProperties.Name="{DynamicResource MappingInterval}"/>
  </StackPanel>
 </StackPanel>
</UserControl>
